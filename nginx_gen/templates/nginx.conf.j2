# Generated by nginx-config-gen
{% for vhost in vhosts %}
server {
    listen {{ vhost.listen_port }}{% if vhost.ssl_enabled %} ssl http2{% endif %};
    server_name {{ vhost.server_name }};

{% if vhost.ssl_enabled %}
    ssl_certificate {{ vhost.ssl_cert_path }};
    ssl_certificate_key {{ vhost.ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
{% if vhost.hsts_enabled %}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
{% endif %}
{% endif %}

{% if vhost.gzip_enabled %}
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
{% endif %}

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;

{% for loc in vhost.locations %}
    location {{ loc.path }} {
        proxy_pass {{ loc.proxy_pass }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

{% if loc.websocket %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}

        client_max_body_size {{ loc.client_max_body_size_mb }}M;
    }
{% endfor %}
}
{% endfor %}
